---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/articles/', label: '文章' },
  { href: '/collections/', label: '专题' },
  { href: '/projects/', label: '项目' },
  { href: '/notes/', label: '记录' },
  { href: '/about/', label: '关于我' },
];
---
<header class="site-header site-shell">
  <a class="site-logo" href="/">TX / FIELD NOTES</a>
  <button class="mobile-nav-toggle" aria-label="打开导航菜单" aria-expanded="false">☰</button>
  <nav class="site-nav" aria-label="主导航">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="site-header-tools"><a href="/search/">搜索</a><a href="https://github.com/TongXuan0403/Myself">GitHub ↗</a></div>
</header>
<script>
  const toggle = document.querySelector('.mobile-nav-toggle');
  const nav = document.querySelector('.site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
