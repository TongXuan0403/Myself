---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, safeProjectLink } from "../../data/content";
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const projectLink = safeProjectLink(project.link);
---
<BaseLayout title={`${project.name} / TX Field Notes`} description={project.summary}>
  <div class="site-page"><a class="site-kicker" href="/projects/">项目 / 实验室</a><h1>{project.name}。</h1><p class="hero-description">{project.summary}</p><div class="band"><div class="about-grid"><div><span class="project-status">{project.status}</span><div class="about-mark">TX</div></div><div class="about-copy"><h2>实现结果</h2><p>{project.result}</p><div class="about-list"><div><span>TECH STACK</span><strong>{project.stack.join(" · ")}</strong></div><div><span>REPOSITORY</span><strong>{projectLink ? <a href={projectLink} target="_blank" rel="noopener noreferrer">{project.link}</a> : "暂无公开链接"}</strong></div></div></div></div></div></div>
</BaseLayout>
