---
import HomeAbout from "../components/HomeAbout.astro";
import HomeStatement from "../components/HomeStatement.astro";
import HomeStream from "../components/HomeStream.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeHighlights, homeMeta } from "../data/home";
---

<BaseLayout title={homeMeta.title} description={homeMeta.description}>
  <section class="hero">
    <p class="kicker">{homeMeta.heroKicker}</p>
    <h1>
      {homeMeta.heroTitleLeading}
      <em>{homeMeta.heroTitleEmphasis}</em>
    </h1>
    <p class="intro">{homeMeta.heroDescription}</p>
    <a class="button" href="#writing">
      开始阅读 ↘
    </a>
  </section>
  <HomeStream items={homeHighlights} />
  <HomeStatement
    kicker="NOW BUILDING"
    title="内容优先，视觉表达，"
    description="第一代公开站点使用 Astro 静态生成，独立发布后台负责草稿、预览和发布。"
  />
  <HomeAbout
    kicker="A LITTLE ABOUT ME"
    title="学习、构建、分享。"
    description="这里不是结论陈列室，更像一张持续更新的工作台。"
  />
</BaseLayout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f3f2ee; color: #1d1e1b; font-family: Arial, "Microsoft YaHei", sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  header, main, footer { margin: auto; max-width: 1180px; padding-left: 32px; padding-right: 32px; }
  header { align-items: center; display: flex; justify-content: space-between; padding-bottom: 28px; padding-top: 28px; }
  header > a, footer, nav a, .kicker, small, .index, .arrow, .section-label { font-family: Consolas, monospace; font-size: 11px; letter-spacing: .04em; }
  nav { display: flex; gap: 26px; } nav a { color: #777872; } nav a:hover { color: #e75b47; }
  .hero { border-bottom: 1px solid #d9d9d2; padding-bottom: 125px; padding-top: 126px; }
  .kicker, small, .section-label { color: #777872; } .kicker { text-transform: uppercase; }
  h1, h2 { font-family: Georgia, "Noto Serif SC", serif; font-weight: 700; letter-spacing: 0; }
  h1 { font-size: clamp(48px, 8vw, 92px); line-height: 1.08; margin: 25px 0; } em { color: #e75b47; font-style: normal; }
  .intro { color: #777872; font-size: 16px; line-height: 1.9; max-width: 430px; }
  .button { background: #e75b47; color: white; display: inline-block; font-family: Consolas, monospace; font-size: 11px; margin-top: 30px; padding: 14px 19px; }
  .stream { padding-bottom: 115px; padding-top: 75px; }.section-label { border-bottom: 1px solid #d9d9d2; display: flex; justify-content: space-between; padding-bottom: 14px; }
  article { align-items: center; border-bottom: 1px solid #d9d9d2; display: grid; gap: 26px; grid-template-columns: 42px 1fr 30px; padding: 26px 0; } article:hover .arrow { color: #e75b47; transform: translate(4px, -4px); } .arrow { transition: transform .25s ease; }
  article h2 { font-size: 25px; margin: 8px 0 4px; } article p, .statement p, .about p { color: #777872; line-height: 1.8; margin: 0; } .index { color: #e75b47; }
  .statement { background: #232622; color: #f3f2ee; margin-left: -32px; margin-right: -32px; padding: 90px clamp(32px, 9vw, 140px); }.statement .kicker { color: #aeb2aa; }.statement h2 { font-size: clamp(32px, 5vw, 60px); max-width: 700px; }.statement p:last-child { max-width: 500px; }
  .about { align-items: center; display: grid; gap: 45px; grid-template-columns: 140px 1fr; padding: 110px 0; }.about > span { align-items: center; background: #dfe58d; display: flex; font-family: Consolas, monospace; height: 140px; justify-content: center; font-size: 38px; }
  footer { border-top: 1px solid #d9d9d2; color: #777872; padding-bottom: 28px; padding-top: 28px; }
  @media (max-width: 600px) { header, main, footer { padding-left: 21px; padding-right: 21px; } nav { gap: 12px; } nav a { font-size: 10px; }.hero { padding-bottom: 76px; padding-top: 78px; } article h2 { font-size: 19px; }.statement { margin-left: -21px; margin-right: -21px; padding: 72px 21px; }.about { gap: 24px; grid-template-columns: 72px 1fr; padding: 75px 0; }.about > span { height: 72px; font-size: 22px; } }
</style>
